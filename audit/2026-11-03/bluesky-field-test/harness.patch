+}
+
+export const unknownCalls = new Map<string, number>()
+
+export function installFetch() {
+  global.fetch = jest.fn(async (input: any, init?: any) => {
+    const url = new URL(typeof input === 'string' ? input : input.url ?? String(input))
+    const m = /\/xrpc\/([\w.]+)/.exec(url.pathname)
+    const json = (status: number, body: any) =>
+      new Response(JSON.stringify(body), {status, headers: {'content-type': 'application/json'}})
+    if (!m) {
+      unknownCalls.set(url.host + url.pathname, (unknownCalls.get(url.host + url.pathname) ?? 0) + 1)
+      return json(404, {error: 'NotFound'})
+    }
+    const nsid = m[1]!
+    const h = handlers[nsid]
+    if (!h) {
+      unknownCalls.set(nsid, (unknownCalls.get(nsid) ?? 0) + 1)
+      return json(501, {error: 'MethodNotImplemented', message: `fake backend: ${nsid}`})
+    }
+    let body
+    try {
+      body = init?.body ? JSON.parse(init.body) : undefined
+    } catch {}
+    return json(200, h(url.searchParams, body))
+  }) as any
+}
