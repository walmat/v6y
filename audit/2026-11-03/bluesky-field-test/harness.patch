+// LOCAL ONLY (v6y field test). Extends the app's own Jest config.
+const base = require('./package.json').jest
+const V6Y = '/var/home/matthew/code/v6y/packages'
+const NM = '<rootDir>/node_modules'
+
+// Extra node_modules that ship untranspiled ESM/TS and are hit when rendering real screens.
+const EXTRA_TRANSFORM = ['@bsky\\.app/.*', 'sonner-native']
+
+module.exports = {
+  ...base,
+  testMatch: ['<rootDir>/__v6y__/**/*.test.tsx'],
+  reporters: ['default'],
+  // Reanimated 4 / worklets ship a resolver that picks their JS (non-native) code under Jest.
+  resolver: 'react-native-reanimated/jest/resolver',
+  setupFilesAfterEnv: [...base.setupFilesAfterEnv, '<rootDir>/__v6y__/setup.ts'],
+  transformIgnorePatterns: base.transformIgnorePatterns.map(p =>
+    p.replace('node_modules/(?!(', `node_modules/(?!(${EXTRA_TRANSFORM.join('|')}|`),
+  ),
+  moduleNameMapper: {
+    ...base.moduleNameMapper,
+    // Node already has full Intl; the formatjs polyfills are ESM-only.
+    '^@formatjs/.*/polyfill.*$': '<rootDir>/__v6y__/empty.js',
+    '^@v6y/core$': `${V6Y}/core`,
+    '^@v6y/react-native$': `${V6Y}/react-native`,
+    // One React / React Native instance: the app's.
+    '^react$': `${NM}/react`,
+    '^react/(.*)$': `${NM}/react/$1`,
+    '^react-native$': `${NM}/react-native`,
+    '^@babel/runtime/(.*)$': `${NM}/@babel/runtime/$1`,
+  },
+}
