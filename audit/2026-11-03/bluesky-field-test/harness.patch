+import fs from 'fs'
+import {act} from 'react-test-renderer'
+
+import {DID, installFetch, seedSession, unknownCalls} from './fakeBackend'
+import {closeSheets, manifest, press, record, RESULTS, renderApp, settle, unmount} from './lib'
+
+jest.setTimeout(600000)
+
+beforeAll(async () => {
+  installFetch()
+  await seedSession()
+})
+
+const BOB_POST = {name: 'bob.test', rkey: '3kv6y00000000'}
+
+/** [capture name, route, params] - every route reachable from the logged-in shell that renders offline. */
+const ROUTES: Array<[string, string, object?]> = [
+  ['Search', 'tab:Search'],
+  ['Notifications', 'tab:Notifications'],
+  ['Messages (inbox)', 'tab:Messages'],
+  ['Home again', 'tab:Home'],
+  ['Profile (own)', 'Profile', {name: DID}],
+  ['Profile (other)', 'Profile', {name: 'bob.test'}],
+  ['ProfileFollowers', 'ProfileFollowers', {name: 'alice.test'}],
+  ['ProfileFollows', 'ProfileFollows', {name: 'alice.test'}],
+  ['PostThread', 'PostThread', BOB_POST],
+  ['PostLikedBy', 'PostLikedBy', BOB_POST],
+  ['PostThread (image post)', 'PostThread', {name: 'bob.test', rkey: '3kv6y00000001'}],
+  ['PostThread (link card)', 'PostThread', {name: 'alice.test', rkey: '3kv6y00000002'}],
+  ['Feeds', 'Feeds'],
+  ['CustomFeed', 'CustomFeed', {name: 'bob.test', rkey: 'cats'}],
+  ['SavedFeeds', 'SavedFeeds'],
+  ['Lists', 'Lists'],
+  ['Bookmarks', 'Bookmarks'],
+  ['Hashtag', 'Hashtag', {tag: 'a11y'}],
+  ['Settings', 'Settings'],
+  ['AccountSettings', 'AccountSettings'],
+  ['PrivacyAndSecuritySettings', 'PrivacyAndSecuritySettings'],
+  ['ActivityPrivacySettings', 'ActivityPrivacySettings'],
+  ['Moderation', 'Moderation'],
+  ['ModerationMutedAccounts', 'ModerationMutedAccounts'],
+  ['ModerationBlockedAccounts', 'ModerationBlockedAccounts'],
+  ['ModerationModlists', 'ModerationModlists'],
+  ['ModerationInteractionSettings', 'ModerationInteractionSettings'],
+  ['NotificationSettings', 'NotificationSettings'],
+  ['ContentAndMediaSettings', 'ContentAndMediaSettings'],
+  ['PreferencesFollowingFeed', 'PreferencesFollowingFeed'],
+  ['PreferencesThreads', 'PreferencesThreads'],
+  ['PreferencesExternalEmbeds', 'PreferencesExternalEmbeds'],
+  ['AccessibilitySettings', 'AccessibilitySettings'],
+  ['AppearanceSettings', 'AppearanceSettings'],
+  ['LanguageSettings', 'LanguageSettings'],
+  ['AboutSettings', 'AboutSettings'],
+  ['AppPasswords', 'AppPasswords'],
+  ['InterestsSettings', 'InterestsSettings'],
+  ['FindContactsSettings', 'FindContactsSettings'],
+  ['BetaFeaturesSettings', 'BetaFeaturesSettings'],
+  ['MessagesSettings', 'MessagesSettings'],
+  ['Support', 'Support'],
+  ['TermsOfService', 'TermsOfService'],
+  ['CommunityGuidelines', 'CommunityGuidelines'],
+  ['NotFound', 'NotFound'],
+  ['Debug (Storybook)', 'Debug'],
+]
+
+/** Error-boundary text among what v6y considered visible (unfocused screens excluded). */
+function crashText(rep: any): string | undefined {
+  const texts: string[] = []
+  const walk = (n: any) => {
+    if (n.hidden) return
+    if (n.text) texts.push(n.text)
+    n.children.forEach(walk)
+  }
+  walk(rep.snapshot.root)
+  const i = texts.findIndex(t => /There was an unexpected issue|Something went wrong/.test(t))
+  return i >= 0 ? texts.slice(i, i + 3).join(' | ') : undefined
+}
+
+it('logged-in screens', async () => {
+  const r = await renderApp()
+  await settle(r, 6)
+  // A real NUX sheet opens on first launch; capture it, then close it like the user would.
+  await record('NUX sheet over Home (InviteFriendsAnnouncement)')
+  await closeSheets(r)
+  await record('Home (following feed)')
+
+  const {navigate, resetToTab} = require('#/Navigation')
+  for (const [name, route, params] of ROUTES) {
+    try {
+      await act(async () => {
+        if (route.startsWith('tab:')) resetToTab(route.slice(4))
+        else void navigate({name: route, params})
+      })
+      await settle(r, 5)
+      await closeSheets(r)
+      const rep = await record(name)
+      const crash = crashText(rep)
+      if (crash) {
+        manifest[manifest.length - 1]!.ok = false
+        manifest[manifest.length - 1]!.error = 'error boundary: ' + crash
+      }
+      void rep
+    } catch (e: any) {
+      manifest.push({name, ok: false, error: String(e?.message ?? e).slice(0, 300)})
+    }
+  }
+  // Overlays opened from the home feed.
+  const overlays: Array<[string, string | RegExp]> = [
+    ['Post options menu (sheet)', 'Open post options menu'],
+    ['Share menu (sheet)', 'Open share menu'],
+    ['Composer', 'New post'],
+  ]
+  for (const [name, label] of overlays) {
+    try {
+      await act(async () => {
+        resetToTab('Home')
+      })
+      await closeSheets(r)
+      await press(r, label)
+      await record(name)
+      await closeSheets(r)
+    } catch (e: any) {
+      manifest.push({name, ok: false, error: String(e?.message ?? e).slice(0, 300)})
+    }
+  }
+  await unmount(r)
+  fs.writeFileSync(
+    `${RESULTS}/_manifest.loggedIn.json`,
+    JSON.stringify({manifest, unknownXrpc: [...unknownCalls.entries()]}, null, 1),
+  )
+})
