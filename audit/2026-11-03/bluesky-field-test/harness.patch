+/* LOCAL ONLY (v6y field test): extra mocks needed to render real screens. */
+
+// The app's jestSetup replaces expo-modules-core with 3 functions; real screens
+// import modules (expo-haptics, ...) that need more of its API.
+/** A native-module stand-in: any property is a callable, constructible no-op. */
+function stubModule(): any {
+  return new Proxy(function () {}, {
+    get: (_t, k) =>
+      k === 'then' ? undefined : typeof k === 'string' && k.endsWith('Async') ? async () => ({}) : stubModule(),
+    apply: () => undefined,
+    construct: () => stubModule(),
+  })
+}
+;(globalThis as any).__v6yStubModule = stubModule
+
+jest.mock('expo-modules-core', () => {
+  const actual = jest.requireActual('expo-modules-core')
+  return {
+    ...actual,
+    requireNativeModule: (name: string) => {
+      if (name === 'ExpoPlatformInfo') return {getIsReducedMotionEnabled: () => false}
+      if (name === 'BottomSheet') return {dismissAll: () => {}}
+      return (globalThis as any).expo?.modules?.[name] ?? (globalThis as any).__v6yStubModule()
+    },
+    requireOptionalNativeModule: (name: string) => (globalThis as any).expo?.modules?.[name] ?? null,
+    // Render native views as host elements (like RN's own Jest mocks) so their children,
+    // e.g. the composer's TextInput inside expo-paste-input, are not swallowed.
+    requireNativeViewManager: (name: string) => {
+      const {createElement} = require('react')
+      const C = (props: any) => createElement(name, props, props.children)
+      C.displayName = name
+      return C
+    },
+    createPermissionHook: () => () => [true],
+  }
+})
+
+jest.mock('expo-asset', () => {
+  const asset = {uri: 'file://asset', localUri: 'file://asset', width: 1, height: 1, downloadAsync: async () => asset}
+  return {Asset: {fromModule: () => asset, loadAsync: async () => [asset]}, useAssets: () => [[asset]]}
+})
+
+jest.mock('react-native-keyboard-controller', () => require('react-native-keyboard-controller/jest'))
+
+// RNGH asks worklets for the UI runtime, which the JS worklets build refuses.
+jest.mock('react-native-worklets', () => ({
+  ...jest.requireActual('react-native-worklets'),
+  getUIRuntimeHolder: () => ({}),
+}))
+
+// Same shape as the app's own useOTAUpdates.test.ts mock.
+jest.mock('expo-updates', () => ({
+  checkForUpdateAsync: jest.fn(async () => ({isAvailable: false})),
+  fetchUpdateAsync: jest.fn(),
+  isEnabled: false,
+  channel: 'production',
+  reloadAsync: jest.fn(),
+  setExtraParamAsync: jest.fn(),
+  UpdateCheckResultNotAvailableReason: {NO_UPDATE_AVAILABLE_ON_SERVER: 'x', UPDATE_PREVIOUSLY_FAILED: 'y'},
+  useUpdates: jest.fn(() => ({currentlyRunning: {}, isUpdateAvailable: false, isUpdatePending: false})),
+}))
+
+// The app's jestSetup mock lacks SafeAreaInsetsContext etc.; use the library's own mock.
+jest.mock('react-native-safe-area-context', () => require('react-native-safe-area-context/jest/mock').default)
+
+jest.mock('expo-notifications', () => {
+  const sub = {remove: () => {}}
+  return {
+    AndroidImportance: {}, AndroidNotificationVisibility: {}, DEFAULT: 'default',
+    addNotificationResponseReceivedListener: () => sub, addPushTokenListener: () => sub,
+    addNotificationReceivedListener: () => sub,
+    clearLastNotificationResponse: () => {}, dismissAllNotificationsAsync: async () => {},
+    getDevicePushTokenAsync: async () => ({type: 'ios', data: 'x'}),
+    getLastNotificationResponse: () => null, getLastNotificationResponseAsync: async () => null,
+    getPermissionsAsync: async () => ({granted: false, status: 'undetermined', canAskAgain: true}),
+    requestPermissionsAsync: async () => ({granted: false, status: 'denied'}),
+    setNotificationChannelAsync: async () => {}, setNotificationChannelGroupAsync: async () => {},
+    setNotificationHandler: () => {}, getBadgeCountAsync: async () => 0, setBadgeCountAsync: async () => true,
+    useLastNotificationResponse: () => null,
+  }
+})
+;(globalThis as any).requestIdleCallback ??= (cb: () => void) => setTimeout(cb, 1)
+;(globalThis as any).cancelIdleCallback ??= (id: any) => clearTimeout(id)
+
+// The app's jestSetup maps NativeEventEmitter to Node's EventEmitter, whose
+// addListener returns the emitter, not a subscription with remove().
+jest.mock('react-native/Libraries/EventEmitter/NativeEventEmitter', () => {
+  const {EventEmitter} = require('events')
+  class NativeEventEmitter extends EventEmitter {
+    addListener(event: string, fn: (...a: any[]) => void) {
+      super.addListener(event, fn)
+      return {remove: () => this.removeListener(event, fn)}
+    }
+    removeAllListeners(event?: string) {
+      super.removeAllListeners(event)
+      return this
+    }
+    listenerCount(event: string) {
+      return super.listenerCount(event)
+    }
+  }
+  return {__esModule: true, default: NativeEventEmitter}
+})
+
+// The app's root __mocks__/multiformats stubs CID out entirely; real responses need it.
+jest.mock('multiformats/cid', () => jest.requireActual('multiformats/cid'))
+jest.mock('multiformats/hashes/hasher', () => jest.requireActual('multiformats/hashes/hasher'))
+
+jest.mock('expo-camera', () => ({
+  Camera: {useCameraPermissions: jest.fn(() => [{granted: false}, jest.fn()])},
+  CameraView: () => null,
+  useCameraPermissions: jest.fn(() => [{granted: false}, jest.fn()]),
+}))
+
+// RN 0.88 host instances have DOM-like getBoundingClientRect; the Jest ScrollView mock doesn't.
+{
+  const RN = require('react-native')
+  for (const C of [RN.ScrollView, RN.TextInput, RN.FlatList, RN.View, RN.Text, RN.Image, RN.TouchableOpacity, RN.TouchableHighlight]) {
+    if (C?.prototype && !C.prototype.getBoundingClientRect) {
+      C.prototype.getBoundingClientRect = () => ({x: 0, y: 0, top: 0, left: 0, right: 390, bottom: 44, width: 390, height: 44})
+    }
+  }
+}
+
+global.fetch = jest.fn(() => Promise.reject(new Error('offline (v6y field test)'))) as any
+
+// react-native-worklets' Jest rAF mock schedules setTimeout(0) jobs; let them
+// drain before Jest tears the environment down, or the worker crashes.
+afterAll(() => new Promise(r => setTimeout(r, 300)))
