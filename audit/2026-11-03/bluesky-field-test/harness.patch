@@ -0,0 +1,162 @@
+/* LOCAL ONLY (v6y field test): helpers to drive the real app and record v6y captures. */
+import fs from 'fs'
+import path from 'path'
+import {StyleSheet} from 'react-native'
+import {act, create, type ReactTestRenderer} from 'react-test-renderer'
+import {V6yProvider, capture, configure} from '@v6y/react-native'
+
+export const RESULTS = process.env.V6Y_RESULTS ?? '/var/home/matthew/code/v6y-field/results'
+
+/** Jest has no layout engine: frames only from explicit numeric width/height (as in the v6y example). */
+const measureFromStyle = async (stateNode: any) => {
+  const style = StyleSheet.flatten(stateNode?.props?.style) ?? {}
+  const width = style.width ?? style.minWidth
+  const height = style.height ?? style.minHeight
+  return typeof width === 'number' && typeof height === 'number'
+    ? {x: 0, y: 0, width, height}
+    : undefined
+}
+
+/** V6Y_DS=1: tell v6y which files are Bluesky's shared components, and its sheet host. */
+const DS_CONFIG = {
+  designSystem: ['src/components/**', 'src/view/com/util/**', 'src/lib/custom-animations/**', 'src/alf/**'],
+  hostTypes: {modal: ['BottomSheet']},
+}
+configure(
+  {extends: 'strict', ...(process.env.V6Y_DS ? DS_CONFIG : {})} as any,
+  {collect: {measure: measureFromStyle}, report: false, log: false, autoCapture: false},
+)
+
+export const wait = (ms: number) =>
+  act(async () => {
+    await new Promise(res => setTimeout(res, ms))
+  })
+
+/** Fake layout + image load so the Splash screen lets the app through. */
+export async function fireLayoutAndLoad(r: ReactTestRenderer) {
+  await act(async () => {
+    for (const n of r.root.findAll((n: any) => typeof n.props.onLayout === 'function')) {
+      try {
+        n.props.onLayout({nativeEvent: {layout: {x: 0, y: 0, width: 390, height: 844}}})
+      } catch {}
+    }
+    for (const n of r.root.findAll((n: any) => typeof n.props.onLoadEnd === 'function')) {
+      try {
+        n.props.onLoadEnd()
+      } catch {}
+    }
+  })
+}
+
+export async function settle(r: ReactTestRenderer, rounds = 6) {
+  for (let i = 0; i < rounds; i++) {
+    await fireLayoutAndLoad(r)
+    await wait(150)
+  }
+}
+
+/** Host refs: RN 0.88 host instances expose DOM-ish APIs the app calls during layout. */
+function createNodeMock() {
+  const rect = {x: 0, y: 0, top: 0, left: 0, right: 390, bottom: 44, width: 390, height: 44}
+  return {
+    getBoundingClientRect: () => rect,
+    measure: (cb: any) => cb(0, 0, 390, 44, 0, 0),
+    measureInWindow: (cb: any) => cb(0, 0, 390, 44),
+    measureLayout: (_n: any, cb: any) => cb(0, 0, 390, 44),
+    focus: () => {},
+    blur: () => {},
+    setNativeProps: () => {},
+    scrollTo: () => {},
+    scrollToOffset: () => {},
+    scrollToIndex: () => {},
+    scrollToEnd: () => {},
+    getScrollableNode: () => null,
+    addEventListener: () => {},
+    removeEventListener: () => {},
+  }
+}
+
+export async function renderApp(): Promise<ReactTestRenderer> {
+  const App = require('#/App').default
+  let r!: ReactTestRenderer
+  await act(async () => {
+    r = create(
+      <V6yProvider>
+        <App />
+      </V6yProvider>,
+      {createNodeMock},
+    )
+  })
+  await settle(r, 10)
+  return r
+}
+
+/** Press the (last mounted, i.e. topmost) element with this accessibility label / testID. */
+export async function press(r: ReactTestRenderer, labelOrId: string | RegExp) {
+  const match = (v: unknown) =>
+    typeof v === 'string' && (typeof labelOrId === 'string' ? v === labelOrId : labelOrId.test(v))
+  const nodes = r.root.findAll(
+    (n: any) =>
+      typeof n.props.onPress === 'function' &&
+      (match(n.props.accessibilityLabel) || match(n.props['aria-label']) || match(n.props.testID)),
+  )
+  const isHiddenNode = (n: any) => {
+    for (let p = n; p; p = p.parent) {
+      const pr = p.props ?? {}
+      if (pr.accessibilityElementsHidden || pr['aria-hidden'] === true) return true
+      if (pr.importantForAccessibility === 'no-hide-descendants') return true
+      if (typeof p.type === 'string' && p.type === 'RNSScreen' && pr.activityState === 0) return true
+    }
+    return false
+  }
+  const visible = nodes.filter(n => !isHiddenNode(n))
+  if (!visible.length) throw new Error(`nothing visible+pressable labelled ${labelOrId} (${nodes.length} hidden)`)
+  const target = visible[visible.length - 1]!
+  await act(async () => {
+    target.props.onPress({nativeEvent: {}, preventDefault() {}, stopPropagation() {}})
+  })
+  await settle(r, 4)
+}
+
+export interface CaptureRecord {
+  name: string
+  ok: boolean
+  error?: string
+  issues?: number
+}
+export const manifest: CaptureRecord[] = []
+
+export async function record(name: string) {
+  const report = await capture(name)
+  if (!report) throw new Error(`no report for ${name}`)
+  fs.mkdirSync(RESULTS, {recursive: true})
+  const file = name.replace(/[^\w]+/g, '_').replace(/^_|_$/g, '') + '.json'
+  fs.writeFileSync(path.join(RESULTS, file), JSON.stringify(report, null, 1))
+  manifest.push({name, ok: true, issues: report.issues.length})
+  return report
+}
+
+export async function unmount(r: ReactTestRenderer) {
+  try {
+    await act(async () => r.unmount())
+  } catch (e) {
+    // Teardown errors (animations, timers) don't affect captures already taken.
+  }
+  await wait(50)
+}
+
+/** Emulate the native bottom sheet reporting "closed" (no native side in Jest). */
+export async function closeSheets(r: ReactTestRenderer) {
+  const sheets = r.root.findAll(
+    (n: any) => n.type === 'BottomSheet' && typeof n.props.onStateChange === 'function',
+  )
+  await act(async () => {
+    for (const s of sheets) {
+      try {
+        s.props.onStateChange({nativeEvent: {state: 'closed'}})
+      } catch {}
+    }
+  })
+  await settle(r, 3)
+  return sheets.length
+}
