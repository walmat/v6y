{
  "name": "v6y-monorepo",
  "private": true,
  "description": "v6y — accessibility auditing for React Native apps",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/babel-plugin",
    "packages/react-native",
    "packages/cli",
    "packages/metro"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/babel-plugin packages/react-native packages/cli packages/metro",
    "test": "npm run build && vitest run",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
